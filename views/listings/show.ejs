<% layout("/layouts/boilerplate")%>
<br/>
<div class="show">
  <div class="show">
    <h3 class="show"><%= listing.title %></h3>
    <div class="show" style="width: 18rem;">
     <img 
  src="<%= listing.image?.url || 'https://images.unsplash.com/photo-1552733407-5d5c46c3bb3b' %>" 
  class="show-img-top shows-img"
  alt="listing_image">

  </div>
</div>
</div>
<p>
  <strong>Hosted by:</strong>
  <%= listing.owner.username %>
</p>
<h5>Details:</h5>
  <ul>
     <li><%= listing.description %></li>
     <li> &#8377;<%= listing.price %></li>
     <li><%= listing.location %></li>
     <li><%= listing.country %></li>
   </ul>
   <br/>
  <% if (currentUser && listing.owner && currentUser._id.equals(listing.owner._id)) { %>
   <div>
   <a href="/listings/<%=listing._id%>/edit" class="btn btn-dark edit-btn">Edit </a>
  <br/><br/>
   <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE"><button class="btn btn-dark del-btn">Delete</button></form>
</div>
 <% } %>
<div class="col-8 offset-3">
  <div
  id="map"
  data-coordinates='<%- JSON.stringify(listing.geometry?.coordinates || [77.2090, 28.6139]) %>'
  style="height: 300px; width: 100%; border-radius: 12px;">
</div>
  <hr>
   <% if (currentUser){ %>
  <h4>Leave a Review </h4>
  <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
   <!-- <div class="mb-3 mt-3" >
      <label for="rating" class="form-label">Rating</label>
      <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range">
    </div>-->
    <div class="mb-3 mt-3" >
      <label for="rating" class="form-label">Rating</label>
    <fieldset class="starability-basic">
  <legend>Rating:</legend>
  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked aria-label="No rating." />
  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
  <label for="first-rate1" title="Terrible">1 star</label>
  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
  <label for="first-rate2" title="Not good">2 stars</label>
  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
  <label for="first-rate3" title="Average">3 stars</label>
  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
  <label for="first-rate4" title="Very good">4 stars</label>
  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
  <label for="first-rate5" title="Amazing">5 stars</label>
  </fieldset>
  </div>
    <div class="mb-3 mt-3" >
      <label for="comment" class="form-label">Comment</label>
      <textarea name="review[comment]" cols="30" rows="5" id="comment" class="form-control" required></textarea>
    <div class="invalid-feedback">Please submit some comments for review</div>
    </div>
    <br/>
    <button class="btn btn-outline-dark">Submit</button>
  </form>
  <% } %>
  <br/>
  <h4>All Reviews</h4>

<div class="row">
  <% for (let review of listing.reviews) { %>

    <div class="col-md-6 mb-3">
      <div class="card">
        <div class="card-body">
          <h5 class="card-title">@<%= review.author.username %></h5>
          <p class="card-text"><%= review.comment %></p>
          <p class="starability-result card-text" data-rating="<%= review.rating %>">
          </p>
           <form method="POST" action="/listings/<%= listing._id%>/reviews/<%= review._id %>?_method=DELETE">
        <button class="btn btn-sm btn-dark">Delete</button>
      </form>
        </div>
      </div>
    </div>

  <% } %>
</div>
<br/>
<script>
  window.onload = function() {
    const mapDiv = document.getElementById("map");
    if (mapDiv && mapDiv.dataset.coordinates) {
      const coordinates = JSON.parse(mapDiv.dataset.coordinates);
      
      const map = L.map("map").setView([coordinates[1], coordinates[0]], 12);

      L.tileLayer(
        `https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=<%= mapToken %>`, 
        {
          attribution: '<a href="https://www.maptiler.com/copyright/" target="_blank">&copy; MapTiler</a> <a href="https://www.openstreetmap.org/copyright" target="_blank">&copy; OpenStreetMap contributors</a>',
        }
      ).addTo(map);

      L.marker([coordinates[1], coordinates[0]])
        .addTo(map)
        .bindPopup("Listing Location")
        .openPopup();
    }
  };
</script>