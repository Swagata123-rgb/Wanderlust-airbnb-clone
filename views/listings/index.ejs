<% layout("/layouts/boilerplate") %>

<!--<div class="mt-2"><h3>All Listings</h3></div>-->

<!--<form method="GET" action="/listings/new">
    <button class="btn btn-dark mb-3">Create New Listing</button>
</form>-->
<style>
    #filters {
  margin-top: 1rem;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 1.5rem;
}

.filter {
  display: flex;
  flex-direction: column;
  align-items: center;
  opacity: 0.8;
  text-decoration: none;
  color: inherit;
}

.filter:hover {
  opacity: 1;
  cursor: pointer;
}

    .tax-info{
        display:none;
    }
    .tax-toggle{
        border:1px solid black;
        border-radius:1rem;
        height:3.5rem;
        padding:1rem;
        margin-left: 4rem;
        display:flex;
        align-items: center;
    }
</style>
<div id="filters">
    <div class="filter">
        <a href="/listings?category=trending" class="filter">
       <div><i class="fa-solid fa-fire"></i></div> 
       <p>Trending</p>
       </a>
    </div>
    <div class="filter">
        <a href="/listings?category=rooms" class="filter">
       <div><i class="fa-solid fa-bed"></i></div> 
       <p>Rooms</p></a>
    </div>
     <div class="filter">
        <a href="/listings?category=iconic" class="filter">
       <div><i class="fa-solid fa-hotel"></i></div> 
       <p>Iconic Citites</p>
    </div>
    <div class="filter">
        <a href="/listings?category=mountain" class="filter">
       <div><i class="fa-solid fa-mountain-city"></i></div> 
       <p>Mountain</p></a>
    </div>
     <div class="filter">
        <a href="/listings?category=pools" class="filter">
       <div><i class="fa-solid fa-person-swimming"></i></div> 
       <p>Pools</p></a>
    </div>
     <div class="filter">
        <a href="/listings?category=resorts" class="filter">
       <div><i class="fa-solid fa-spa"></i></div> 
       <p>Resorts and Spa</p></a>
    </div>
     <div class="filter">
        <a href="/listings?category=camping" class="filter">
       <div><i class="fa-solid fa-tree"></i></div> 
       <p>Camping</p></a>
    </div>
     <div class="filter">
        <a href="/listings?category=farms" class="filter">
       <div><i class="fa-solid fa-cow"></i></div> 
       <p>Farms</p></a>
    </div>
     <div class="filter">
        <a href="/listings?category=arctic" class="filter">
       <div><i class="fa-solid fa-snowflake"></i></div> 
       <p>Arctic</p></a>
    </div>
    <div class="filter">
        <a href="/listings?category=domes" class="filter">
       <div><i class="fa-solid fa-igloo"></i></div> 
       <p>Domes</p></a>
    </div>
    <div class="filter">
        <a href="/listings?category=new" class="filter">
       <div><i class="fa-solid fa-key"></i></div> 
       <p>New</p></a>
    </div>
    <div class="tax-toggle mb-3">
        <div class="form-check-reverse form-switch">
  <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
  <label class="form-check-label" for="switchCheckDefault">Display Taxes to be added</label>
</div>
    </div>
</div>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
    <% for (let listing of allListings) { %>
        <div class="col mb-4">
            <div class="card listing-card border-0 shadow-sm">

                <img 
                    src="<%= listing.image.url %>" 
                    class="card-img-top" 
                    alt="listing_image"
                >

                <div class="card-body">
                    <p class="card-text">
                        <b><%= listing.title %></b> <br>
                        &#8377; <%= listing.price.toLocaleString("en-IN") %> / night
                        <i class="tax-info">+18% GST</i>
                    </p>

                    <a 
                        href="/listings/<%= listing._id %>" 
                        class="stretched-link"
                    ></a>
                </div>
            </div>
        </div>
    <% } %>
</div>
<script>
  const taxSwitch = document.getElementById("switchCheckDefault");

  taxSwitch.addEventListener("change", () => {
    const taxInfo = document.getElementsByClassName("tax-info");

    for (let info of taxInfo) {
      if (info.style.display === "inline") {
        info.style.display = "none";
      } else {
        info.style.display = "inline";
      }
    }
  });
</script>

